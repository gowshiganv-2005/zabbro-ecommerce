{
    "version": 2,
    "redirects": [
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": "zabbro-ecommerce.vercel.app"
                }
            ],
            "destination": "https://zabbro.space/$1",
            "permanent": true
        },
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": "www.zabbro.space"
                }
            ],
            "destination": "https://zabbro.space/$1",
            "permanent": true
        }
    ],
    "builds": [
        {
            "src": "server/server.js",
            "use": "@vercel/node"
        },
        {
            "src": "public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "server/server.js"
        },
        {
            "src": "/uploads/(.*)",
            "dest": "public/uploads/$1"
        },
        {
            "src": "/(css|js)/(.*)",
            "dest": "public/$1/$2"
        },
        {
            "src": "/robots.txt",
            "dest": "public/robots.txt"
        },
        {
            "src": "/sitemap.xml",
            "dest": "public/sitemap.xml"
        },
        {
            "src": "/manifest.json",
            "dest": "public/manifest.json"
        },
        {
            "src": "/(.*\\.(html|ico|png|jpg|jpeg|svg|webp|gif|xml|txt|json|webmanifest))",
            "dest": "public/$1"
        },
        {
            "src": "/(.*)",
            "dest": "public/index.html"
        }
    ]
}